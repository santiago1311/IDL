// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "08/04/2026 13:49:22"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    Registro4Bits
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module Registro4Bits_vlg_sample_tst(
	clk,
	D,
	Enable,
	sampler_tx
);
input  clk;
input [3:0] D;
input  Enable;
output sampler_tx;

reg sample;
time current_time;
always @(clk or D or Enable)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module Registro4Bits_vlg_check_tst (
	Ou,
	sampler_rx
);
input [3:0] Ou;
input sampler_rx;

reg [3:0] Ou_expected;

reg [3:0] Ou_prev;

reg [3:0] Ou_expected_prev;

reg [3:0] last_Ou_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	Ou_prev = Ou;
end

// update expected /o prevs

always @(trigger)
begin
	Ou_expected_prev = Ou_expected;
end


// expected Ou[ 3 ]
initial
begin
	Ou_expected[3] = 1'bX;
end 
// expected Ou[ 2 ]
initial
begin
	Ou_expected[2] = 1'bX;
end 
// expected Ou[ 1 ]
initial
begin
	Ou_expected[1] = 1'bX;
end 
// expected Ou[ 0 ]
initial
begin
	Ou_expected[0] = 1'bX;
end 
// generate trigger
always @(Ou_expected or Ou)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Ou = %b | ",Ou_expected_prev);
	$display("| real Ou = %b | ",Ou_prev);
`endif
	if (
		( Ou_expected_prev[0] !== 1'bx ) && ( Ou_prev[0] !== Ou_expected_prev[0] )
		&& ((Ou_expected_prev[0] !== last_Ou_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Ou[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Ou_expected_prev);
		$display ("     Real value = %b", Ou_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Ou_exp[0] = Ou_expected_prev[0];
	end
	if (
		( Ou_expected_prev[1] !== 1'bx ) && ( Ou_prev[1] !== Ou_expected_prev[1] )
		&& ((Ou_expected_prev[1] !== last_Ou_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Ou[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Ou_expected_prev);
		$display ("     Real value = %b", Ou_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Ou_exp[1] = Ou_expected_prev[1];
	end
	if (
		( Ou_expected_prev[2] !== 1'bx ) && ( Ou_prev[2] !== Ou_expected_prev[2] )
		&& ((Ou_expected_prev[2] !== last_Ou_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Ou[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Ou_expected_prev);
		$display ("     Real value = %b", Ou_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Ou_exp[2] = Ou_expected_prev[2];
	end
	if (
		( Ou_expected_prev[3] !== 1'bx ) && ( Ou_prev[3] !== Ou_expected_prev[3] )
		&& ((Ou_expected_prev[3] !== last_Ou_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Ou[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Ou_expected_prev);
		$display ("     Real value = %b", Ou_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Ou_exp[3] = Ou_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Registro4Bits_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg [3:0] D;
reg Enable;
// wires                                               
wire [3:0] Ou;

wire sampler;                             

// assign statements (if any)                          
Registro4Bits i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.D(D),
	.Enable(Enable),
	.Ou(Ou)
);
// D[ 3 ]
initial
begin
	D[3] = 1'b1;
	D[3] = #100000 1'b0;
end 
// D[ 2 ]
initial
begin
	D[2] = 1'b1;
	D[2] = #200000 1'b0;
end 
// D[ 1 ]
initial
begin
	D[1] = 1'b1;
	D[1] = #100000 1'b0;
end 
// D[ 0 ]
initial
begin
	D[0] = 1'b1;
	D[0] = #200000 1'b0;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 

// Enable
initial
begin
	Enable = 1'b0;
	Enable = #40000 1'b1;
	Enable = #20000 1'b0;
	Enable = #80000 1'b1;
	Enable = #20000 1'b0;
	Enable = #260000 1'b1;
	Enable = #20000 1'b0;
end 

Registro4Bits_vlg_sample_tst tb_sample (
	.clk(clk),
	.D(D),
	.Enable(Enable),
	.sampler_tx(sampler)
);

Registro4Bits_vlg_check_tst tb_out(
	.Ou(Ou),
	.sampler_rx(sampler)
);
endmodule

