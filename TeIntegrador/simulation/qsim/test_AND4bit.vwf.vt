// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "08/04/2026 13:53:29"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    And4bits
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module And4bits_vlg_sample_tst(
	An,
	Bn,
	E,
	sampler_tx
);
input [3:0] An;
input [3:0] Bn;
input  E;
output sampler_tx;

reg sample;
time current_time;
always @(An or Bn or E)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module And4bits_vlg_check_tst (
	Sn,
	sampler_rx
);
input [3:0] Sn;
input sampler_rx;

reg [3:0] Sn_expected;

reg [3:0] Sn_prev;

reg [3:0] Sn_expected_prev;

reg [3:0] last_Sn_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	Sn_prev = Sn;
end

// update expected /o prevs

always @(trigger)
begin
	Sn_expected_prev = Sn_expected;
end


// expected Sn[ 3 ]
initial
begin
	Sn_expected[3] = 1'bX;
end 
// expected Sn[ 2 ]
initial
begin
	Sn_expected[2] = 1'bX;
end 
// expected Sn[ 1 ]
initial
begin
	Sn_expected[1] = 1'bX;
end 
// expected Sn[ 0 ]
initial
begin
	Sn_expected[0] = 1'bX;
end 
// generate trigger
always @(Sn_expected or Sn)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Sn = %b | ",Sn_expected_prev);
	$display("| real Sn = %b | ",Sn_prev);
`endif
	if (
		( Sn_expected_prev[0] !== 1'bx ) && ( Sn_prev[0] !== Sn_expected_prev[0] )
		&& ((Sn_expected_prev[0] !== last_Sn_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Sn[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Sn_expected_prev);
		$display ("     Real value = %b", Sn_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Sn_exp[0] = Sn_expected_prev[0];
	end
	if (
		( Sn_expected_prev[1] !== 1'bx ) && ( Sn_prev[1] !== Sn_expected_prev[1] )
		&& ((Sn_expected_prev[1] !== last_Sn_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Sn[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Sn_expected_prev);
		$display ("     Real value = %b", Sn_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Sn_exp[1] = Sn_expected_prev[1];
	end
	if (
		( Sn_expected_prev[2] !== 1'bx ) && ( Sn_prev[2] !== Sn_expected_prev[2] )
		&& ((Sn_expected_prev[2] !== last_Sn_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Sn[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Sn_expected_prev);
		$display ("     Real value = %b", Sn_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Sn_exp[2] = Sn_expected_prev[2];
	end
	if (
		( Sn_expected_prev[3] !== 1'bx ) && ( Sn_prev[3] !== Sn_expected_prev[3] )
		&& ((Sn_expected_prev[3] !== last_Sn_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Sn[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Sn_expected_prev);
		$display ("     Real value = %b", Sn_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Sn_exp[3] = Sn_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module And4bits_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] An;
reg [3:0] Bn;
reg E;
// wires                                               
wire [3:0] Sn;

wire sampler;                             

// assign statements (if any)                          
And4bits i1 (
// port map - connection between master ports and signals/registers   
	.An(An),
	.Bn(Bn),
	.E(E),
	.Sn(Sn)
);
// An[ 3 ]
initial
begin
	An[3] = 1'b0;
	An[3] = #300000 1'b1;
	An[3] = #100000 1'b0;
	An[3] = #100000 1'b1;
	An[3] = #200000 1'b0;
	An[3] = #100000 1'b1;
	An[3] = #180000 1'b0;
end 
// An[ 2 ]
initial
begin
	An[2] = 1'b1;
	An[2] = #100000 1'b0;
	An[2] = #500000 1'b1;
	An[2] = #100000 1'b0;
	An[2] = #100000 1'b1;
	An[2] = #180000 1'b0;
end 
// An[ 1 ]
initial
begin
	An[1] = 1'b1;
	An[1] = #300000 1'b0;
	An[1] = #100000 1'b1;
	An[1] = #580000 1'b0;
end 
// An[ 0 ]
initial
begin
	An[0] = 1'b1;
	An[0] = #200000 1'b0;
	An[0] = #200000 1'b1;
	An[0] = #200000 1'b0;
	An[0] = #100000 1'b1;
	An[0] = #200000 1'b0;
end 
// Bn[ 3 ]
initial
begin
	Bn[3] = 1'b1;
	Bn[3] = #100000 1'b0;
	Bn[3] = #600000 1'b1;
	Bn[3] = #200000 1'b0;
end 
// Bn[ 2 ]
initial
begin
	Bn[2] = 1'b0;
	Bn[2] = #300000 1'b1;
	Bn[2] = #200000 1'b0;
	Bn[2] = #200000 1'b1;
	Bn[2] = #100000 1'b0;
	Bn[2] = #100000 1'b1;
end 
// Bn[ 1 ]
initial
begin
	Bn[1] = 1'b1;
	Bn[1] = #100000 1'b0;
	Bn[1] = #100000 1'b1;
	Bn[1] = #500000 1'b0;
	Bn[1] = #100000 1'b1;
	Bn[1] = #100000 1'b0;
end 
// Bn[ 0 ]
initial
begin
	Bn[0] = 1'b0;
	Bn[0] = #200000 1'b1;
	Bn[0] = #300000 1'b0;
	Bn[0] = #300000 1'b1;
end 

// E
initial
begin
	E = 1'b0;
	E = #75000 1'b1;
	E = #75000 1'b0;
	E = #125000 1'b1;
	E = #75000 1'b0;
	E = #100000 1'b1;
	E = #50000 1'b0;
	E = #25000 1'b1;
	E = #25000 1'b0;
	E = #25000 1'b1;
	E = #25000 1'b0;
	E = #50000 1'b1;
	E = #25000 1'b0;
	E = #25000 1'b1;
	E = #25000 1'b0;
	E = #25000 1'b1;
	E = #25000 1'b0;
	E = #25000 1'b1;
	E = #50000 1'b0;
	E = #25000 1'b1;
	E = #50000 1'b0;
	E = #50000 1'b1;
end 

And4bits_vlg_sample_tst tb_sample (
	.An(An),
	.Bn(Bn),
	.E(E),
	.sampler_tx(sampler)
);

And4bits_vlg_check_tst tb_out(
	.Sn(Sn),
	.sampler_rx(sampler)
);
endmodule

